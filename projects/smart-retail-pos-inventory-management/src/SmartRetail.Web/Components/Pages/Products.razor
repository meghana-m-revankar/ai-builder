@page "/products"
<PageTitle>Products | Smart Retail</PageTitle>

<div class="p-6">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-h2 font-bold">Inventory</h1>
        <button class="bg-brand-700 text-white px-6 py-2 rounded-xl">Add Product</button>
    </div>
    <div class="bg-white rounded-2xl border border-line p-6">
        <table class="w-full text-left">
            <thead>
                <tr class="border-b border-line">
                    <th class="pb-4">SKU</th>
                    <th class="pb-4">Name</th>
                    <th class="pb-4">Price</th>
                    <th class="pb-4">Stock</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b border-line last:border-0">
                    <td class="py-4">SKU-001</td>
                    <td class="py-4">Wireless Mouse</td>
                    <td class="py-4">$29.99</td>
                    <td class="py-4">124</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
