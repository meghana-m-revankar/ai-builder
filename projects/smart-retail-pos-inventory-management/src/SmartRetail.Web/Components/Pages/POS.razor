@page "/pos"
<PageTitle>POS | Smart Retail</PageTitle>

<div class="p-6 grid grid-cols-12 gap-8">
    <div class="col-span-8">
        <h1 class="text-h2 font-bold mb-6">Point of Sale</h1>
        <div class="grid grid-cols-3 gap-4">
            <div class="p-4 bg-white border border-line rounded-xl">Item 1</div>
            <div class="p-4 bg-white border border-line rounded-xl">Item 2</div>
        </div>
    </div>
    <div class="col-span-4 bg-white p-6 rounded-2xl border border-line shadow-lg">
        <h2 class="text-h4 font-bold mb-4">Cart Summary</h2>
        <div class="space-y-4">
            <div class="flex justify-between"><span>Subtotal</span><span>$0.00</span></div>
            <button class="w-full bg-accent-500 text-white py-3 rounded-xl">Complete Order</button>
        </div>
    </div>
</div>
