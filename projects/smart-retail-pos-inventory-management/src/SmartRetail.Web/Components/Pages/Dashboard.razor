@page "/"
<PageTitle>Dashboard | Smart Retail</PageTitle>

<div class="p-6">
    <h1 class="text-h2 font-bold mb-8">Dashboard</h1>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-line shadow-sm">
            <h3 class="text-ink-600">Daily Revenue</h3>
            <p class="text-hero font-bold">$12,450</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-line shadow-sm">
            <h3 class="text-ink-600">Active Orders</h3>
            <p class="text-hero font-bold">42</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-line shadow-sm">
            <h3 class="text-ink-600">Low Stock Items</h3>
            <p class="text-hero font-bold text-danger">8</p>
        </div>
    </div>
</div>
