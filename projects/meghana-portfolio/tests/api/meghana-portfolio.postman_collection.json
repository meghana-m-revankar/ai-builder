{
  "info": {
    "name": "meghana-portfolio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Contact",
      "item": [
        {
          "name": "TC-API-001 Submit Message",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"John\", \"email\": \"john@example.com\", \"message\": \"Hi\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/contact"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test(\"status is 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
