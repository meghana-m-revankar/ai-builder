{
	"info": {
		"_postman_id": "meghana-portfolio-api",
		"name": "Meghana Portfolio API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Contact",
			"item": [
				{
					"name": "TC-API-002 Create contact message",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\"name\": \"Test\", \"email\": \"test@test.com\", \"message\": \"hello\"}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/contact", "host": ["{{baseUrl}}"], "path": ["api", "contact"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
									"pm.test(\"fast enough\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
								]
							}
						}
					]
				}
			]
		}
	]
}
