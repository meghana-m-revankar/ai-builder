{
  "info": {
    "name": "Portfolio API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Contact",
      "item": [
        {
          "name": "TC-API-002 Create contact",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/contact",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"John\", \"email\": \"john@example.com\", \"message\": \"Hi\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
