{
	"info": {
		"_postman_id": "bloom-api-collection",
		"name": "Bloom Flower Shop API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Bouquets",
			"item": [
				{
					"name": "TC-API-001 List Bouquets",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/bouquets"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('fast', () => pm.expect(pm.response.responseTime).to.be.below(500));"] }}]
				},
				{
					"name": "TC-API-002 Create Bouquet",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/v1/bouquets"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"] }}]
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "TC-API-005 No token",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/v1/orders"
					},
					"event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] }}]
				}
			]
		}
	]
}
