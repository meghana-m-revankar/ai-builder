@page "/order"
@inject IOrderService OrderService

<PageTitle>Order | Golden Crust Bakery</PageTitle>

<div class="container py-5">
    <h2>Place a Pre-order</h2>
    <EditForm Model="orderModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Product</label>
            <InputSelect @bind-Value="orderModel.ProductId" class="form-control">
                @foreach (var p in products) { <option value="@p.Id">@p.Name</option> }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label>Quantity</label>
            <InputNumber @bind-Value="orderModel.Quantity" class="form-control" />
        </div>
        <button type="submit" class="btn btn-success">Confirm Order</button>
    </EditForm>
</div>

@code {
    private OrderCommand orderModel = new();
    private List<ProductDto> products = new();
    private async Task HandleSubmit() => await OrderService.CreateAsync(orderModel);
}
