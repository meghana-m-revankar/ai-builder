@page "/shop"
@using GoldenCrust.Application.DTOs
@inject HttpClient Http

<PageTitle>Shop | Golden Crust</PageTitle>

<div class="container py-5">
    <h2 class="mb-4">Our Products</h2>
    <div class="row g-4">
        @if (products == null) {
            <p>Loading...</p>
        } else {
            @foreach (var prod in products) {
                <div class="col-md-4">
                    <div class="card h-100 p-3">
                        <h3>@prod.Name</h3>
                        <p class="text-muted">@prod.Description</p>
                        <p class="h5">AED @prod.Price</p>
                        <button class="btn btn-primary mt-auto" @onclick="() => SelectProduct(prod)">Add to Order</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<ProductDto>? products;
    protected override async Task OnInitializedAsync() => products = await Http.GetFromJsonAsync<List<ProductDto>>("api/v1/products");
    private void SelectProduct(ProductDto p) { /* Logic */ }
}
