@page "/admin"
@attribute [Authorize(Roles = "Admin")]

<div class="container-fluid">
    <div class="row">
        <aside class="col-md-2 bg-light vh-100 p-3">
            <h5>Admin Menu</h5>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link" href="/admin/orders">Manage Orders</a></li>
            </ul>
        </aside>
        <main class="col-md-10 p-4">
            <h2>Active Orders</h2>
            <table class="table">
                <thead>
                    <tr><th>Customer</th><th>Product</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var order in orders) {
                        <tr>
                            <td>@order.CustomerName</td>
                            <td>@order.ProductName</td>
                            <td>@order.Status</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => MarkReady(order.Id)">Mark Ready</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </main>
    </div>
</div>

@code {
    private List<OrderDto> orders = new();
    private async Task MarkReady(Guid id) => await OrderService.UpdateStatusAsync(id, "Ready");
}
