<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Golden Crust Bakery | Dubai Artisan Bakery</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.469.0/dist/umd/lucide.min.js"></script>
    <style>
        :root {
            --brand-900: #0B1B3F;
            --brand-700: #1E3A8A;
            --brand-500: #3B5BDB;
            --brand-100: #E7ECFB;
            --accent-500: #F97316;
            --surface: #FFFFFF;
            --canvas: #F6F7FB;
            --ink-900: #0F172A;
            --ink-600: #475569;
            --line: #E2E8F0;
        }
        body { font-family: 'Inter', sans-serif; background: var(--canvas); color: var(--ink-900); }
        h1, h2, h3 { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; letter-spacing: -0.02em; }
        .navbar { background: rgba(255,255,255,.9); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
        .btn-primary { background: var(--brand-700); border: none; padding: 12px 24px; border-radius: 8px; }
        .card { border-radius: 12px; border: none; box-shadow: 0 1px 2px rgba(15,23,42,.06); transition: transform .2s; }
        .card:hover { transform: translateY(-2px); }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="#">GoldenCrust</a>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary">EN/AR</button>
            <button class="btn btn-primary">Pre-Order</button>
        </div>
    </div>
</nav>

<header class="container py-5 text-center">
    <h1 class="display-2 mb-4">Authentic <span class="text-primary">Artisan</span> Bread in Dubai</h1>
    <p class="lead text-muted">Freshly baked, daily delivery. Experience the tradition.</p>
</header>

<main class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 p-4">
                <h3>Sourdough</h3>
                <p class="text-muted">Classic rustic loaf.</p>
                <div class="mt-auto pt-3"><strong>45 AED</strong></div>
            </div>
        </div>
    </div>
</main>

<script>lucide.createIcons();</script>
</body>
</html>
