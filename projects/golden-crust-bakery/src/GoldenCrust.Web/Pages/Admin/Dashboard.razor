@page "/admin"
@attribute [Authorize(Roles = "Admin")]

<div class="d-flex">
    <aside class="sidebar bg-dark text-white p-3 vh-100">
        <h3>Admin Panel</h3>
        <nav class="nav flex-column">
            <a class="nav-link text-white" href="/admin/orders">Orders</a>
        </nav>
    </aside>
    <main class="flex-grow-1 p-4">
        <h2>Order Management</h2>
        <table class="table table-hover mt-4">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @* Render order list *@
            </tbody>
        </table>
    </main>
</div>
