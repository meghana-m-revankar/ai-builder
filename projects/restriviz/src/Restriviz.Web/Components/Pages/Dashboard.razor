@page "/"
<PageTitle>Dashboard</PageTitle>

<div class="p-6">
    <h1 class="text-h2 font-bold mb-6">Dashboard</h1>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
            <h3 class="text-ink-600">Active Orders</h3>
            <p class="text-4xl font-bold font-mono">12</p>
        </div>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
            <h3 class="text-ink-600">Today's Sales</h3>
            <p class="text-4xl font-bold font-mono">₹ 12,450</p>
        </div>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
            <h3 class="text-ink-600">Low Stock Items</h3>
            <p class="text-4xl font-bold font-mono text-danger">3</p>
        </div>
    </div>
</div>
