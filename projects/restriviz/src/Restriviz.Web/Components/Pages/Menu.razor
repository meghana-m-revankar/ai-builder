@page "/menu"

<div class="p-6">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-h1 font-bold">Menu Management</h1>
        <button class="bg-brand-700 text-white px-6 py-2 rounded-lg font-bold">Add Item</button>
    </div>
    
    <div class="bg-white rounded-2xl border border-line overflow-hidden">
        <table class="w-full">
            <thead class="bg-canvas">
                <tr>
                    <th class="text-left p-4">Item Name</th>
                    <th class="text-left p-4">Category</th>
                    <th class="text-left p-4">Price</th>
                    <th class="text-left p-4">Status</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-t border-line">
                    <td class="p-4">Cappuccino</td>
                    <td class="p-4">Beverages</td>
                    <td class="p-4">₹180</td>
                    <td class="p-4"><span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-small">Available</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
