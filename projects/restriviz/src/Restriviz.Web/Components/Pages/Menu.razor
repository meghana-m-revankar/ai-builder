@page "/menu"
<PageTitle>Menu Management</PageTitle>

<div class="p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-h2 font-bold">Menu Management</h1>
        <button class="bg-brand-700 text-white px-6 py-2 rounded-lg font-semibold">Add Product</button>
    </div>
    
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-slate-50">
                <tr>
                    <th class="p-4">Name</th>
                    <th class="p-4">Category</th>
                    <th class="p-4">Price</th>
                    <th class="p-4">Status</th>
                    <th class="p-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Row template -->
                <tr class="border-t">
                    <td class="p-4">Masala Chai</td>
                    <td class="p-4">Beverages</td>
                    <td class="p-4 font-mono">₹ 40.00</td>
                    <td class="p-4"><span class="bg-success-100 text-success px-2 py-1 rounded-full text-sm">Available</span></td>
                    <td class="p-4 text-brand-700 font-semibold cursor-pointer">Edit</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
