@page "/pos"
<PageTitle>New Order</PageTitle>

<div class="h-screen flex p-6 gap-6">
    <!-- Products Selection -->
    <div class="flex-grow">
        <h1 class="text-h2 font-bold mb-6">New Order</h1>
        <div class="grid grid-cols-3 gap-4">
            <!-- Product Cards -->
            <div class="p-4 border rounded-xl hover:shadow-md cursor-pointer">
                <p class="font-bold">Filter Coffee</p>
                <p class="text-ink-600 font-mono">₹ 60.00</p>
            </div>
        </div>
    </div>
    
    <!-- Order Summary -->
    <div class="w-96 bg-white p-6 rounded-2xl shadow-lg border border-slate-100 flex flex-col">
        <h2 class="text-h4 font-bold mb-4">Current Order</h2>
        <div class="flex-grow space-y-4">
            <div class="flex justify-between">
                <span>Filter Coffee x 1</span>
                <span class="font-mono">₹ 60.00</span>
            </div>
        </div>
        <div class="border-t pt-4 mt-4">
            <div class="flex justify-between text-xl font-bold">
                <span>Total</span>
                <span class="font-mono">₹ 60.00</span>
            </div>
            <button class="w-full mt-6 bg-accent-500 text-white py-3 rounded-xl font-bold">Pay Now</button>
        </div>
    </div>
</div>
