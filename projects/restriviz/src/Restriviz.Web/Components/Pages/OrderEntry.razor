@page "/pos"

<div class="flex h-screen overflow-hidden">
    <!-- Product Grid -->
    <div class="flex-1 p-6 overflow-y-auto">
        <h1 class="text-h2 font-bold mb-6">Take Order</h1>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <!-- Product Cards -->
            <div class="bg-white p-4 rounded-xl border border-line cursor-pointer hover:border-brand-500 transition">
                <h4 class="font-bold">Cappuccino</h4>
                <p class="text-ink-600 mt-1">₹180</p>
            </div>
        </div>
    </div>
    
    <!-- Sidebar Cart -->
    <div class="w-80 bg-white border-l border-line p-6 flex flex-col">
        <h2 class="text-h4 font-bold mb-4">Order Summary</h2>
        <div class="flex-1">
            <p class="text-ink-600 text-center py-10">Cart is empty</p>
        </div>
        <button class="w-full bg-brand-700 text-white py-3 rounded-xl font-bold hover:bg-brand-900">
            Process Payment
        </button>
    </div>
</div>
