@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation

<div class="flex h-screen bg-slate-50 font-sans text-slate-900 overflow-hidden">
    <!-- Sidebar Navigation -->
    <aside class="w-64 bg-slate-900 text-slate-300 flex flex-col border-r border-slate-800">
        <!-- Logo Area -->
        <div class="h-16 flex items-center px-6 gap-3 border-b border-slate-800 text-white">
            <div class="p-2 bg-purple-600 rounded-xl text-white">
                <i data-lucide="heart-pulse" class="w-5 h-5"></i>
            </div>
            <span class="font-extrabold text-lg tracking-tight">JioLife</span>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 px-4 py-6 space-y-1.5">
            <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition hover:bg-slate-800 hover:text-white" ActiveClass="bg-purple-700 text-white shadow-lg shadow-purple-900/30">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                Dashboard
            </NavLink>
            <NavLink href="activities" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition hover:bg-slate-800 hover:text-white" ActiveClass="bg-purple-700 text-white shadow-lg shadow-purple-900/30">
                <i data-lucide="activity" class="w-5 h-5"></i>
                Activities
            </NavLink>
            <NavLink href="plans" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition hover:bg-slate-800 hover:text-white" ActiveClass="bg-purple-700 text-white shadow-lg shadow-purple-900/30">
                <i data-lucide="sparkles" class="w-5 h-5"></i>
                Wellness Plans
            </NavLink>
            <NavLink href="metrics" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition hover:bg-slate-800 hover:text-white" ActiveClass="bg-purple-700 text-white shadow-lg shadow-purple-900/30">
                <i data-lucide="scale" class="w-5 h-5"></i>
                Health Metrics
            </NavLink>
            <NavLink href="profile" class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition hover:bg-slate-800 hover:text-white" ActiveClass="bg-purple-700 text-white shadow-lg shadow-purple-900/30">
                <i data-lucide="user" class="w-5 h-5"></i>
                Profile
            </NavLink>
        </nav>

        <!-- User Footer Card -->
        <div class="p-4 border-t border-slate-800">
            <div class="flex items-center gap-3 px-3 py-2 bg-slate-800/50 rounded-xl">
                <img src="https://i.pravatar.cc/80?u=Alex" alt="Alex Johnson" class="w-9 h-9 rounded-full object-cover" />
                <div class="overflow-hidden">
                    <p class="text-sm font-semibold text-white truncate">Alex Johnson</p>
                    <p class="text-xs text-slate-400 truncate">Pro Member</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Top Bar -->
        <header class="h-16 bg-white border-b border-slate-200 px-8 flex items-center justify-between z-10">
            <div class="flex items-center gap-4 w-96">
                <div class="relative w-full">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-3 text-slate-400"></i>
                    <input type="text" placeholder="Search activities, plans, metrics..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-4 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-500" />
                </div>
            </div>
            <div class="flex items-center gap-4">
                <button aria-label="Notifications" class="p-2 text-slate-500 hover:bg-slate-50 rounded-xl relative">
                    <i data-lucide="bell" class="w-5 h-5"></i>
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-purple-600 rounded-full"></span>
                </button>
                <div class="h-6 w-px bg-slate-200"></div>
                <div class="flex items-center gap-3">
                    <span class="text-sm font-semibold text-slate-900">Alex Johnson</span>
                    <img src="https://i.pravatar.cc/80?u=Alex" alt="Alex" class="w-8 h-8 rounded-full object-cover" />
                </div>
            </div>
        </header>

        <!-- Page Body Scroll Container -->
        <main class="flex-1 overflow-y-auto p-8 bg-[#F8FAFC]">
            @Body
        </main>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await InvokeAsync(() => { });
    }
}
