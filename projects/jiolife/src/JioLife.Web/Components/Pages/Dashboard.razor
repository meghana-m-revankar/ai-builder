@page "/"
@inject NavigationManager Navigation

<PageTitle>JioLife - Dashboard</PageTitle>

<div class="space-y-6">
    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-purple-700 to-indigo-800 text-white p-8 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight">Welcome back, Alex! 👋</h1>
            <p class="text-purple-100 mt-1">Here is your daily wellness snapshot. You're 80% towards your weekly goal.</p>
        </div>
        <button @onclick="NavigateToActivities" class="bg-white text-purple-900 font-semibold px-6 py-3 rounded-xl shadow-md hover:bg-purple-50 transition flex items-center gap-2">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Log Activity
        </button>
    </div>

    <!-- KPI Bento Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div class="p-3 bg-purple-100 text-purple-700 rounded-xl">
                    <i data-lucide="footprints" class="w-6 h-6"></i>
                </div>
                <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">+12%</span>
            </div>
            <div class="mt-4">
                <p class="text-sm font-medium text-slate-500">Daily Steps</p>
                <h3 class="text-2xl font-bold text-slate-900 mt-1">8,432</h3>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div class="p-3 bg-purple-100 text-purple-700 rounded-xl">
                    <i data-lucide="flame" class="w-6 h-6"></i>
                </div>
                <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">+5%</span>
            </div>
            <div class="mt-4">
                <p class="text-sm font-medium text-slate-500">Calories Burned</p>
                <h3 class="text-2xl font-bold text-slate-900 mt-1">640 kcal</h3>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div class="p-3 bg-purple-100 text-purple-700 rounded-xl">
                    <i data-lucide="timer" class="w-6 h-6"></i>
                </div>
                <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">On Track</span>
            </div>
            <div class="mt-4">
                <p class="text-sm font-medium text-slate-500">Active Minutes</p>
                <h3 class="text-2xl font-bold text-slate-900 mt-1">75 mins</h3>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="flex justify-between items-start">
                <div class="p-3 bg-purple-100 text-purple-700 rounded-xl">
                    <i data-lucide="heart-pulse" class="w-6 h-6"></i>
                </div>
                <span class="text-xs font-semibold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-full">Normal</span>
            </div>
            <div class="mt-4">
                <p class="text-sm font-medium text-slate-500">Avg Heart Rate</p>
                <h3 class="text-2xl font-bold text-slate-900 mt-1">72 bpm</h3>
            </div>
        </div>
    </div>

    <!-- Recent Activity Section -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-slate-900">Recent Activities</h2>
            <button @onclick="NavigateToActivities" class="text-purple-700 font-semibold text-sm hover:underline">View All</button>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 text-slate-400 text-xs font-semibold uppercase tracking-wider">
                        <th class="py-3 px-4">Activity</th>
                        <th class="py-3 px-4">Duration</th>
                        <th class="py-3 px-4">Calories</th>
                        <th class="py-3 px-4">Logged At</th>
                    </tr>
                </thead>
                <tbody class="text-slate-600 divide-y divide-slate-50">
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-4 px-4 font-semibold text-slate-900 flex items-center gap-3">
                            <span class="p-2 bg-purple-50 text-purple-700 rounded-lg"><i data-lucide="activity" class="w-4 h-4"></i></span>
                            Morning Run
                        </td>
                        <td class="py-4 px-4">45 mins</td>
                        <td class="py-4 px-4 font-mono text-slate-900">420 kcal</td>
                        <td class="py-4 px-4 text-slate-400">Today, 07:30 AM</td>
                    </tr>
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-4 px-4 font-semibold text-slate-900 flex items-center gap-3">
                            <span class="p-2 bg-purple-50 text-purple-700 rounded-lg"><i data-lucide="activity" class="w-4 h-4"></i></span>
                            Vinyasa Yoga
                        </td>
                        <td class="py-4 px-4">30 mins</td>
                        <td class="py-4 px-4 font-mono text-slate-900">180 kcal</td>
                        <td class="py-4 px-4 text-slate-400">Yesterday, 06:00 PM</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private void NavigateToActivities()
    {
        Navigation.NavigateTo("/activities");
    }
}
