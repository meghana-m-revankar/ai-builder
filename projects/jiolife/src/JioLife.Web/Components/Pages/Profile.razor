@page "/profile"

<PageTitle>JioLife - Profile & Settings</PageTitle>

<div class="space-y-6 max-w-4xl">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">Profile & Settings</h1>
        <p class="text-slate-500">Manage your account information and notification preferences.</p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-6">
        <h2 class="text-lg font-bold text-slate-900">Personal Information</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">First Name</label>
                <input type="text" value="Alex" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Last Name</label>
                <input type="text" value="Johnson" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-500" />
            </div>
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Email Address</label>
                <input type="email" value="alex.johnson@example.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-500" />
            </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex justify-end">
            <button class="bg-purple-700 hover:bg-purple-800 text-white font-semibold px-6 py-2.5 rounded-xl shadow-md transition">
                Save Changes
            </button>
        </div>
    </div>
</div>
