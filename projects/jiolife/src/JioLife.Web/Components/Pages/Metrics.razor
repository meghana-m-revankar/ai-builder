@page "/metrics"

<PageTitle>JioLife - Health Metrics</PageTitle>

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Health Metrics</h1>
            <p class="text-slate-500">Monitor your vital biometrics and historical measurements.</p>
        </div>
        <button class="bg-purple-700 hover:bg-purple-800 text-white font-semibold px-5 py-2.5 rounded-xl shadow-md transition flex items-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i> Add Record
        </button>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 text-slate-400 text-xs font-semibold uppercase tracking-wider">
                        <th class="py-3 px-4">Metric Name</th>
                        <th class="py-3 px-4">Value</th>
                        <th class="py-3 px-4">Recorded At</th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="text-slate-600 divide-y divide-slate-50">
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-4 px-4 font-semibold text-slate-900 flex items-center gap-3">
                            <span class="p-2 bg-purple-50 text-purple-700 rounded-lg"><i data-lucide="scale" class="w-4 h-4"></i></span>
                            Weight
                        </td>
                        <td class="py-4 px-4 font-mono text-slate-900">72.5 kg</td>
                        <td class="py-4 px-4 text-slate-400">2023-10-25 08:00 AM</td>
                        <td class="py-4 px-4 text-right">
                            <button class="text-slate-400 hover:text-slate-600 p-1 rounded-lg"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                        </td>
                    </tr>
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-4 px-4 font-semibold text-slate-900 flex items-center gap-3">
                            <span class="p-2 bg-purple-50 text-purple-700 rounded-lg"><i data-lucide="heart" class="w-4 h-4"></i></span>
                            Blood Pressure
                        </td>
                        <td class="py-4 px-4 font-mono text-slate-900">120/80 mmHg</td>
                        <td class="py-4 px-4 text-slate-400">2023-10-24 09:15 AM</td>
                        <td class="py-4 px-4 text-right">
                            <button class="text-slate-400 hover:text-slate-600 p-1 rounded-lg"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
