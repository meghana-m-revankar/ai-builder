@page "/plans"

<PageTitle>JioLife - Wellness Plans</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">Curated Wellness Plans</h1>
        <p class="text-slate-500">Choose expert-designed programs tailored to your lifestyle goals.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Basic Plan -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition">
            <div>
                <span class="px-3 py-1 bg-purple-50 text-purple-700 text-xs font-semibold rounded-full">Starter</span>
                <h3 class="text-xl font-bold text-slate-900 mt-4">Essential Fitness</h3>
                <p class="text-slate-500 text-sm mt-2">Basic workout routines and daily step tracking guidance.</p>
                <div class="my-6">
                    <span class="text-4xl font-extrabold text-slate-900">$0</span>
                    <span class="text-slate-400">/ forever</span>
                </div>
                <ul class="space-y-3 text-sm text-slate-600">
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-emerald-600"></i> Standard activity logging</li>
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-emerald-600"></i> Basic metric tracking</li>
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-emerald-600"></i> Community support</li>
                </ul>
            </div>
            <button class="mt-8 w-full bg-slate-100 hover:bg-slate-200 text-slate-900 font-semibold py-3 rounded-xl transition">
                Current Plan
            </button>
        </div>

        <!-- Pro Plan (Highlighted) -->
        <div class="bg-purple-900 text-white rounded-2xl shadow-xl p-6 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-amber-400 text-slate-900 text-xs font-bold px-3 py-1 rounded-bl-xl uppercase tracking-wider">Popular</div>
            <div>
                <span class="px-3 py-1 bg-purple-800 text-purple-200 text-xs font-semibold rounded-full">Advanced</span>
                <h3 class="text-xl font-bold mt-4">JioLife Pro</h3>
                <p class="text-purple-200 text-sm mt-2">Advanced analytics, customized nutrition plans, and expert coaching.</p>
                <div class="my-6">
                    <span class="text-4xl font-extrabold">$19</span>
                    <span class="text-purple-300">/ month</span>
                </div>
                <ul class="space-y-3 text-sm text-purple-100">
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-amber-400"></i> Unlimited activity logging</li>
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-amber-400"></i> Deep health analytics</li>
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-amber-400"></i> Personalized meal plans</li>
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-amber-400"></i> Priority support</li>
                </ul>
            </div>
            <button class="mt-8 w-full bg-white text-purple-900 hover:bg-purple-50 font-semibold py-3 rounded-xl transition shadow-lg">
                Upgrade Now
            </button>
        </div>

        <!-- Elite Plan -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition">
            <div>
                <span class="px-3 py-1 bg-purple-50 text-purple-700 text-xs font-semibold rounded-full">Ultimate</span>
                <h3 class="text-xl font-bold text-slate-900 mt-4">Elite Wellness</h3>
                <p class="text-slate-500 text-sm mt-2">One-on-one personal training sessions and live telehealth access.</p>
                <div class="my-6">
                    <span class="text-4xl font-extrabold text-slate-900">$49</span>
                    <span class="text-slate-400">/ month</span>
                </div>
                <ul class="space-y-3 text-sm text-slate-600">
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-emerald-600"></i> Everything in Pro</li>
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-emerald-600"></i> 1-on-1 virtual trainer</li>
                    <li class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-emerald-600"></i> Biometric device sync</li>
                </ul>
            </div>
            <button class="mt-8 w-full bg-purple-700 hover:bg-purple-800 text-white font-semibold py-3 rounded-xl transition shadow-md">
                Choose Elite
            </button>
        </div>
    </div>
</div>
