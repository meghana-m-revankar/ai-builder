@page "/vans"
<PageTitle>Fleet Management | Fleet Tracker</PageTitle>

<div class="container-fluid py-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h2>Fleet Management</h2>
        <button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New Van</button>
    </header>
    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Plate Number</th><th>Model</th><th>Status</th><th>Last Maintenance</th><th>Actions</th></tr>
            </thead>
            <tbody>
                <tr><td>TRK-001</td><td>Ford Transit</td><td><span class="badge bg-success-subtle text-success">Active</span></td><td>2023-10-15</td><td><button class="btn btn-sm btn-outline-secondary">Edit</button></td></tr>
            </tbody>
        </table>
    </div>
</div>
