<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fleet Tracker Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.469.0/dist/umd/lucide.min.js"></script>
    <style>
        :root {
            --brand-900: #0B1B3F; --brand-700: #1E3A8A; --brand-500: #3B5BDB; --brand-100: #E7ECFB;
            --accent-500: #F97316; --surface: #FFFFFF; --canvas: #F6F7FB; --ink-900: #0F172A;
            --ink-600: #475569; --line: #E2E8F0;
        }
        body { font-family: 'Inter', sans-serif; background-color: var(--canvas); color: var(--ink-900); }
        h1, h2, h3 { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; letter-spacing: -0.02em; }
        .sidebar { width: 240px; background: var(--brand-900); height: 100vh; position: fixed; color: white; }
        .main-content { margin-left: 240px; padding: 48px; }
        .card { border-radius: 12px; border: none; box-shadow: 0 1px 2px rgba(15,23,42,.06), 0 8px 24px rgba(15,23,42,.06); }
        .btn-primary { background: var(--brand-700); border-radius: 8px; font-weight: 600; padding: 10px 20px; }
        .kpi-card { padding: 24px; }
    </style>
</head>
<body>
    <aside class="sidebar p-4 d-none d-lg-block">
        <h2 class="text-white mb-5 fs-4">FleetTracker</h2>
        <nav class="nav flex-column gap-3">
            <a class="nav-link text-white active" href="#"><i data-lucide="layout-dashboard" class="me-2"></i> Dashboard</a>
            <a class="nav-link text-white-50" href="#"><i data-lucide="truck" class="me-2"></i> Vans</a>
            <a class="nav-link text-white-50" href="#"><i data-lucide="wrench" class="me-2"></i> Maintenance</a>
            <a class="nav-link text-white-50" href="#"><i data-lucide="bar-chart-3" class="me-2"></i> Reports</a>
        </nav>
    </aside>

    <main class="main-content">
        <header class="d-flex justify-content-between align-items-center mb-5">
            <h1>Fleet Overview</h1>
            <button class="btn btn-primary"><i data-lucide="plus" class="me-2"></i>Add Maintenance</button>
        </header>

        <section class="row g-4">
            <div class="col-12 col-md-6 col-lg-3"><div class="card kpi-card"><h3>40</h3><p class="text-muted">Total Vans</p></div></div>
            <div class="col-12 col-md-6 col-lg-3"><div class="card kpi-card"><h3>36</h3><p class="text-success">Active Status</p></div></div>
            <div class="col-12 col-md-6 col-lg-3"><div class="card kpi-card"><h3>4</h3><p class="text-warning">In Maintenance</p></div></div>
            <div class="col-12 col-md-6 col-lg-3"><div class="card kpi-card"><h3>$12.4k</h3><p class="text-muted">Month Cost</p></div></div>
        </section>
    </main>

    <script>lucide.createIcons();</script>
</body>
</html>
