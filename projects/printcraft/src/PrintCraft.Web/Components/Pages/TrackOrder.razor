@page "/track"
@inject HttpClient Http

<main class="max-w-3xl mx-auto p-6">
    <h1 class="text-h2 mb-8">Track Your Order</h1>
    <div class="flex gap-4">
        <input @bind="orderId" placeholder="Enter Order ID" class="border border-line rounded-lg px-4 py-2 flex-grow" />
        <button @onclick="LoadOrder" class="bg-brand-700 text-white px-6 py-2 rounded-lg">Track</button>
    </div>

    @if (order != null) {
        <div class="mt-8 p-6 bg-surface rounded-2xl border border-line">
            <h2 class="text-h4">Order Status: @order.Status</h2>
            <p>Total: @order.TotalAmount.ToString("C")</p>
        </div>
    }
</main>

@code {
    private string orderId = "";
    private Order? order;
    private async Task LoadOrder() => order = await Http.GetFromJsonAsync<Order>($"api/v1/orders/{orderId}");
    public record Order(string Status, decimal TotalAmount);
}
