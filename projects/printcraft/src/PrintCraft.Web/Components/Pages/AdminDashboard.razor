@page "/admin"
<div class="flex h-screen bg-slate-100">
    <aside class="w-64 bg-slate-900 text-white p-6">
        <h1 class="text-xl font-bold mb-10">PrintCraft Admin</h1>
        <nav class="space-y-4">
            <a href="/admin" class="block py-2 text-violet-400">Dashboard</a>
            <a href="/admin/orders" class="block py-2 text-slate-300">Orders</a>
        </nav>
    </aside>
    <main class="flex-1 p-8 overflow-y-auto">
        <h2 class="text-h3 font-bold mb-6">Overview</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="p-6 bg-white rounded-xl shadow-sm">
                <p class="text-slate-500">Pending Orders</p>
                <p class="text-3xl font-bold">12</p>
            </div>
        </div>
        <table class="w-full bg-white rounded-xl shadow-sm">
            <thead class="bg-slate-50 border-b">
                <tr>
                    <th class="p-4 text-left">Order ID</th>
                    <th class="p-4 text-left">Status</th>
                    <th class="p-4 text-left">Total</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="p-4 font-mono text-sm">#ORD-9921</td>
                    <td class="p-4"><span class="px-3 py-1 rounded-full bg-amber-100 text-amber-700 text-sm font-semibold">Pending</span></td>
                    <td class="p-4">₹ 1,299</td>
                </tr>
            </tbody>
        </table>
    </main>
</div>
