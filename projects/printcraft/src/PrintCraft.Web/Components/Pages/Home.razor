@page "/"
@inject HttpClient Http

<PageTitle>PrintCraft - Custom Printing</PageTitle>

<header class="sticky top-0 bg-white/70 backdrop-blur-md z-50 border-b border-line">
    <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold text-brand-900">Print<span class="text-brand-700">Craft</span></a>
        <div class="flex gap-6">
            <a href="/" class="text-ink-600 hover:text-brand-700">Products</a>
            <a href="/track" class="text-ink-600 hover:text-brand-700">Track Order</a>
        </div>
    </nav>
</header>

<main class="max-w-7xl mx-auto p-6">
    <h1 class="hero-title my-12 text-center">Quality prints, <span class="text-brand-700">made by you</span>.</h1>
    
    <div class="grid md:grid-cols-3 gap-8">
        @if (products == null) { <p>Loading products...</p> }
        else {
            @foreach (var prod in products) {
                <div class="bg-surface p-6 rounded-2xl shadow-sm border border-line">
                    <h3 class="text-h4">@prod.Name</h3>
                    <p class="text-ink-600">@prod.BasePrice.ToString("C")</p>
                    <a href="/product/@prod.Id" class="mt-4 block text-center bg-brand-700 text-white rounded-full py-2">View Details</a>
                </div>
            }
        }
    </div>
</main>

@code {
    private IEnumerable<Product>? products;
    protected override async Task OnInitializedAsync() => products = await Http.GetFromJsonAsync<IEnumerable<Product>>("api/v1/products");
    public record Product(int Id, string Name, decimal BasePrice);
}
