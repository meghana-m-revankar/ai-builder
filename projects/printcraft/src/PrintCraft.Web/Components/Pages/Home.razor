@page "/"
<div class="bg-slate-50 min-h-screen">
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
        <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
            <h1 class="text-2xl font-bold text-violet-700">PrintCraft</h1>
            <div class="space-x-6">
                <a href="/catalog" class="text-slate-600 hover:text-violet-700">Products</a>
                <a href="/login" class="bg-violet-600 text-white px-5 py-2 rounded-full font-semibold">Get Started</a>
            </div>
        </nav>
    </header>
    <main class="max-w-7xl mx-auto px-6 py-16">
        <section class="text-center">
            <h2 class="hero-title text-slate-900 mb-6">Bring your <span class="text-violet-600">ideas</span> to life.</h2>
            <p class="text-lead text-slate-600 max-w-2xl mx-auto mb-10">Premium custom printing for your business and creativity. Quality guaranteed, delivered to your doorstep.</p>
            <div class="flex gap-4 justify-center">
                <a href="/catalog" class="bg-violet-700 text-white px-8 py-4 rounded-full font-bold">Start Printing</a>
            </div>
        </section>
    </main>
</div>
