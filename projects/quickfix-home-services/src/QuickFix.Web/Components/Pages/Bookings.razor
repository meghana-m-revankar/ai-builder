@page "/bookings"
@rendermode InteractiveServer
<h2 class="text-2xl font-bold mb-6">Bookings</h2>
<div class="bg-white rounded-lg shadow p-6">
    <table class="w-full">
        <thead><tr class="text-left border-b"><th>Customer</th><th>Service</th><th>Status</th></tr></thead>
        <tbody>
            @foreach(var b in bookings) {
                <tr class="border-b"><td>@b.Customer</td><td>@b.Service</td><td><StatusBadge Status="@b.Status" /></td></tr>
            }
        </tbody>
    </table>
</div>
@code {
    private List<BookingDto> bookings = new() { new("John Doe", "Plumbing", "Pending") };
    public record BookingDto(string Customer, string Service, string Status);
}