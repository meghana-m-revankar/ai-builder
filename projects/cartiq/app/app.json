{
  "expo": {
    "name": "CartIq",
    "slug": "cartiq",
    "scheme": "cartiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1e3a8a",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.cartiq.app",
      "supportsTablet": true,
      "usesAppleSignIn": false
    },
    "android": {
      "package": "com.cartiq.app",
      "adaptiveIcon": {
        "backgroundColor": "#1e3a8a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1e3a8a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "websiteUrl": "https://meghana-m-revankar.github.io/ai-builder/projects/cartiq/site/"
    }
  }
}
