@page "/dashboard"
<div class="d-flex">
    <aside class="sidebar bg-dark text-white p-3" style="width: 240px; min-height: 100vh;">
        <h3>BrewPoint</h3>
        <nav class="nav flex-column">
            <a class="nav-link text-white" href="/dashboard">Orders</a>
            <a class="nav-link text-white" href="/inventory">Inventory</a>
        </nav>
    </aside>
    <main class="flex-grow-1 p-4">
        <h2>Live Orders</h2>
        <table class="table table-hover mt-3">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>#BP-9982</td>
                    <td>Jane Doe</td>
                    <td><span class="badge bg-success">Ready</span></td>
                    <td><button class="btn btn-sm btn-outline-primary">Details</button></td>
                </tr>
            </tbody>
        </table>
    </main>
</div>
