// Note: Since this is a static site with no backend API, 
// these tests are placeholders for requirements compliance.
{
  "collection": {
    "info": {
      "name": "Flower Shop API",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
      {
        "name": "TC-API-001 List flowers",
        "request": {
          "method": "GET",
          "url": "{{baseUrl}}/api/v1/flowers"
        },
        "event": [
          {
            "listen": "test",
            "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] }
          }
        ]
      }
    ]
  }
}
