@inherits LayoutComponentBase
<div class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 bg-[#FFFBF6]/80 backdrop-blur-md border-b border-[#EADFD3]">
        <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
            <a href="/" class="text-2xl font-display font-extrabold text-[#5D3A25]">Chai Corner</a>
            <div class="flex gap-6 font-medium text-[#6B5B4E]">
                <a href="/">Home</a>
