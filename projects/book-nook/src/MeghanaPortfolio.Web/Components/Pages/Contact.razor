@page "/contact"

<PageTitle>Contact & Booking | Meghana M Revankar</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-extrabold text-accent-500 uppercase tracking-widest block mb-2">Get in Touch</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-brand-900 tracking-tight">Let's build something amazing together</h1>
        <p class="text-lg text-ink-600 mt-4">Have a project in mind or need a senior front-end developer? Drop a message below.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left: Contact Details -->
        <div class="lg:col-span-5 space-y-6">
            <div class="bg-brand-900 text-white rounded-3xl p-8 shadow-xl">
                <h3 class="text-2xl font-bold mb-6">Contact Information</h3>
                <p class="text-slate-300 text-sm mb-8 leading-relaxed">Fill out the form or reach out directly via email or phone. I typically respond within 24 hours.</p>

                <div class="space-y-6">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-accent-500">
                            <i data-lucide="phone" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <span class="block text-xs text-slate-400 uppercase font-semibold">Direct Email</span>
                            <span class="font-bold text-white">meghana@example.com</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-accent-500">
                            <i data-lucide="map-pin" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <span class="block text-xs text-slate-400 uppercase font-semibold">Location</span>
                            <span class="font-bold text-white">Bengaluru, Karnataka, India</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-accent-500">
                            <i data-lucide="clock" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <span class="block text-xs text-slate-400 uppercase font-semibold">Working Hours</span>
                            <span class="font-bold text-white">Mon - Fri, 9:00 AM - 6:00 PM IST</span>
                        </div>
                    </div>
                </div>

                <div class="pt-8 mt-8 border-t border-white/10 flex items-center gap-4">
                    <a href="https://github.com" target="_blank" class="w-10 h-10 rounded-full bg-white/5 hover:bg-accent-500 hover:text-white flex items-center justify-center transition" aria-label="GitHub"><i data-lucide="code" class="w-5 h-5"></i></a>
                    <a href="https://linkedin.com" target="_blank" class="w-10 h-10 rounded-full bg-white/5 hover:bg-accent-500 hover:text-white flex items-center justify-center transition" aria-label="LinkedIn"><i data-lucide="users" class="w-5 h-5"></i></a>
                    <a href="https://instagram.com" target="_blank" class="w-10 h-10 rounded-full bg-white/5 hover:bg-accent-500 hover:text-white flex items-center justify-center transition" aria-label="Instagram"><i data-lucide="instagram" class="w-5 h-5"></i></a>
                </div>
            </div>
        </div>

        <!-- Right: Contact Form -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-8 sm:p-12 border border-line shadow-sm">
            @if (isSubmitted)
            {
                <div class="text-center py-12 space-y-4 animate-fadeIn">
                    <div class="w-20 h-20 bg-green-50 text-success rounded-full flex items-center justify-center mx-auto shadow-sm">
                        <i data-lucide="circle-check" class="w-10 h-10"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-brand-900">Message Sent Successfully!</h3>
                    <p class="text-ink-600 max-w-md mx-auto">Thank you for reaching out, @model.FullName. I have received your inquiry and will get back to you within 24 hours.</p>
                    <button @onclick="ResetForm" class="px-6 py-3 rounded-xl bg-brand-700 text-white font-semibold hover:bg-brand-900 transition mt-4">Send Another Message</button>
                </div>
            }
            else
            {
                <form @onsubmit="HandleSubmit" class="space-y-6">
                    <h3 class="text-2xl font-bold text-brand-900 mb-6">Send a Project Inquiry</h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-ink-900 mb-2">Full Name *</label>
                            <input type="text" @bind="model.FullName" required placeholder="John Doe" class="w-full px-4 py-3 rounded-xl bg-canvas border border-line text-sm focus:outline-none focus:border-brand-700" />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-ink-900 mb-2">Email Address *</label>
                            <input type="email" @bind="model.Email" required placeholder="john@example.com" class="w-full px-4 py-3 rounded-xl bg-canvas border border-line text-sm focus:outline-none focus:border-brand-700" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-ink-900 mb-2">Project Type</label>
                            <select @bind="model.ProjectType" class="w-full px-4 py-3 rounded-xl bg-canvas border border-line text-sm focus:outline-none focus:border-brand-700">
                                <option value="Landing Page">Starter Landing Page ($750)</option>
                                <option value="Full Web App">Full Web App / SaaS ($1,850)</option>
                                <option value="Retainer">Custom Retainer ($3,500/mo)</option>
                                <option value="Other">Other Inquiry</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-ink-900 mb-2">Estimated Budget</label>
                            <select @bind="model.Budget" class="w-full px-4 py-3 rounded-xl bg-canvas border border-line text-sm focus:outline-none focus:border-brand-700">
                                <option value="$500 - $1,000">$500 - $1,000</option>
                                <option value="$1,000 - $3,000">$1,000 - $3,000</option>
                                <option value="$3,000+">$3,000+</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-ink-900 mb-2">Project Message *</label>
                        <textarea @bind="model.Message" required rows="5" placeholder="Tell me about your project scope, design files (Figma), and timeline..." class="w-full px-4 py-3 rounded-xl bg-canvas border border-line text-sm focus:outline-none focus:border-brand-700"></textarea>
                    </div>

                    <button type="submit" class="w-full py-4 rounded-xl bg-accent-500 hover:bg-orange-600 text-white font-bold transition shadow-lg flex items-center justify-center gap-2">
                        <i data-lucide="phone" class="w-5 h-5"></i> Send Message Now
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@code {
    private class ContactModel
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string ProjectType { get; set; } = "Full Web App";
        public string Budget { get; set; } = "$1,000 - $3,000";
        public string Message { get; set; } = "";
    }

    private ContactModel model = new();
    private bool isSubmitted = false;

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(model.FullName) && !string.IsNullOrWhiteSpace(model.Email) && !string.IsNullOrWhiteSpace(model.Message))
        {
            isSubmitted = true;
        }
    }

    private void ResetForm()
    {
        model = new();
        isSubmitted = false;
    }
}
