@page "/services"

<PageTitle>Services & Pricing | Meghana M Revankar</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-extrabold text-accent-500 uppercase tracking-widest block mb-2">Professional Services</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-brand-900 tracking-tight">Flexible Developer Packages</h1>
        <p class="text-lg text-ink-600 mt-4">From Figma-to-code conversions to full-stack Blazor and React web applications, tailored for startups and growing enterprises.</p>
    </div>

    <!-- Pricing Tiers Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch mb-20">
        <!-- Tier 1 -->
        <div class="bg-white rounded-3xl p-8 border border-line shadow-sm flex flex-col justify-between">
            <div>
                <span class="text-xs font-extrabold text-brand-700 bg-brand-100 px-3.5 py-1.5 rounded-full uppercase tracking-wider">Starter Landing</span>
                <div class="my-6">
                    <span class="text-4xl font-extrabold text-brand-900 font-mono">$750</span>
                    <span class="text-ink-600 text-sm ml-2">/ project</span>
                </div>
                <p class="text-ink-600 text-sm mb-6">Perfect for early-stage startups needing a stunning, high-converting marketing website.</p>
                
                <ul class="space-y-4 mb-8 text-sm text-ink-900">
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-success"></i> 1-5 Responsive Pages</li>
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-success"></i> Tailwind CSS styling</li>
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-success"></i> Mobile-first optimized</li>
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-success"></i> 5-day rapid delivery</li>
                </ul>
            </div>
            <a href="contact" class="w-full py-3.5 rounded-xl bg-brand-100 hover:bg-brand-700 text-brand-700 hover:text-white font-bold text-center transition">
                Select Starter
            </a>
        </div>

        <!-- Tier 2 (Highlighted) -->
        <div class="bg-brand-900 text-white rounded-3xl p-8 border-2 border-accent-500 shadow-2xl flex flex-col justify-between relative transform lg:-translate-y-4">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-accent-500 text-white px-4 py-1.5 rounded-full font-bold text-xs uppercase tracking-wider shadow-md">
                Most Popular
            </div>
            <div>
                <span class="text-xs font-extrabold text-white/80 bg-white/10 px-3.5 py-1.5 rounded-full uppercase tracking-wider">Full Web App UI</span>
                <div class="my-6">
                    <span class="text-4xl font-extrabold text-white font-mono">$1,850</span>
                    <span class="text-slate-300 text-sm ml-2">/ project</span>
                </div>
                <p class="text-slate-300 text-sm mb-6">Ideal for SaaS products and e-commerce stores requiring dynamic components and APIs.</p>
                
                <ul class="space-y-4 mb-8 text-sm text-white">
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-accent-500"></i> Multi-page SPA or Blazor / React</li>
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-accent-500"></i> Advanced UI components & tables</li>
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-accent-500"></i> Authentication & state management</li>
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-accent-500"></i> API integration & testing</li>
                </ul>
            </div>
            <a href="contact" class="w-full py-3.5 rounded-xl bg-accent-500 hover:bg-orange-600 text-white font-bold text-center transition shadow-lg">
                Select Full App
            </a>
        </div>

        <!-- Tier 3 -->
        <div class="bg-white rounded-3xl p-8 border border-line shadow-sm flex flex-col justify-between">
            <div>
                <span class="text-xs font-extrabold text-brand-700 bg-brand-100 px-3.5 py-1.5 rounded-full uppercase tracking-wider">Custom Retainer</span>
                <div class="my-6">
                    <span class="text-4xl font-extrabold text-brand-900 font-mono">$3,500</span>
                    <span class="text-ink-600 text-sm ml-2">/ month</span>
                </div>
                <p class="text-ink-600 text-sm mb-6">Dedicated front-end engineering power for ongoing product development and design system scaling.</p>
                
                <ul class="space-y-4 mb-8 text-sm text-ink-900">
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-success"></i> Dedicated developer hours</li>
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-success"></i> Design system & component library</li>
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-success"></i> Priority code reviews & QA</li>
                    <li class="flex items-center gap-3"><i data-lucide="circle-check" class="w-5 h-5 text-success"></i> Direct Slack / Teams comms</li>
                </ul>
            </div>
            <a href="contact" class="w-full py-3.5 rounded-xl bg-brand-100 hover:bg-brand-700 text-brand-700 hover:text-white font-bold text-center transition">
                Start Retainer
            </a>
        </div>
    </div>

    <!-- FAQ Section -->
    <div class="max-w-3xl mx-auto bg-white rounded-3xl p-8 sm:p-12 border border-line shadow-sm">
        <h3 class="text-2xl font-bold text-brand-900 mb-8 text-center">Frequently Asked Questions</h3>
        
        <div class="space-y-6">
            <div>
                <h4 class="font-bold text-brand-900 mb-2 flex items-center gap-2"><i data-lucide="help-circle" class="w-5 h-5 text-brand-700"></i> What is your typical turnaround time?</h4>
                <p class="text-ink-600 text-sm pl-7">Landing pages take 3-5 days, while complex web applications and dashboards typically require 2-4 weeks depending on scope.</p>
            </div>
            <div class="border-t border-line pt-6">
                <h4 class="font-bold text-brand-900 mb-2 flex items-center gap-2"><i data-lucide="help-circle" class="w-5 h-5 text-brand-700"></i> Do you convert Figma files to code?</h4>
                <p class="text-ink-600 text-sm pl-7">Yes! I specialize in taking your Figma, Adobe XD, or Sketch designs and turning them into pixel-perfect, fully responsive HTML/Tailwind or Blazor components.</p>
            </div>
            <div class="border-t border-line pt-6">
                <h4 class="font-bold text-brand-900 mb-2 flex items-center gap-2"><i data-lucide="help-circle" class="w-5 h-5 text-brand-700"></i> Where are you located?</h4>
                <p class="text-ink-600 text-sm pl-7">I am based in Bengaluru, India, working with clients globally across US, European, and Asian time zones.</p>
            </div>
        </div>
    </div>
</div>
