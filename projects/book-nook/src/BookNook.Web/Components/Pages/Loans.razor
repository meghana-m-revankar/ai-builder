@page "/loans"
@using BookNook.Domain.Entities
@using BookNook.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject BookNookDbContext Db

<PageTitle>Circulation & Loans - Book Nook Library</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold font-display text-brand-900 tracking-tight">Circulation & Loans</h1>
            <p class="text-ink-600 mt-1">Issue books, process returns and manage checkout history.</p>
        </div>
        <button class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-700 text-white rounded-xl font-medium text-sm hover:bg-brand-500 transition-all shadow-md">
            <i data-lucide="book-check" class="w-4 h-4"></i>
            Issue Book to Member
        </button>
    </div>

    <!-- Loans Table -->
    <div class="bg-white rounded-2xl border border-line shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-canvas border-b border-line text-xs font-semibold text-ink-600 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Book Title</th>
                        <th class="py-3.5 px-6">Member</th>
                        <th class="py-3.5 px-6">Issue Date</th>
                        <th class="py-3.5 px-6">Due Date</th>
                        <th class="py-3.5 px-6">Status / Fine</th>
                        <th class="py-3.5 px-6 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line text-sm">
                    @if (loans.Any())
                    {
                        @foreach (var loan in loans)
                        {
                            <tr class="hover:bg-canvas/50 transition-colors">
                                <td class="py-4 px-6 font-bold text-brand-900">@loan.Book?.Title</td>
                                <td class="py-4 px-6 text-ink-600">@loan.Member?.Name <span class="text-xs text-ink-600">(@loan.Member?.Class)</span></td>
                                <td class="py-4 px-6 font-mono text-xs text-ink-600">@loan.IssueDate.ToString("dd MMM yyyy")</td>
                                <td class="py-4 px-6 font-mono text-xs text-ink-600">@loan.DueDate.ToString("dd MMM yyyy")</td>
                                <td class="py-4 px-6">
                                    @if (loan.ReturnDate != null)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Returned</span>
                                    }
                                    else if (loan.DueDate < DateTime.UtcNow)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-rose-50 text-rose-700">Overdue (₹@loan.Fine)</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-50 text-amber-700">Active Loan</span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-right">
                                    @if (loan.ReturnDate == null)
                                    {
                                        <button @onclick="() => ReturnBook(loan.Id)" class="px-3 py-1.5 bg-brand-700 text-white rounded-lg text-xs font-medium hover:bg-brand-500 transition-colors">
                                            Return Book
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-ink-600">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-ink-600">No active loans found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Loan> loans = new();

    protected override async Task OnInitializedAsync()
    {
        loans = await Db.Loans
            .Include(l => l.Book)
            .Include(l => l.Member)
            .OrderByDescending(l => l.IssueDate)
            .ToListAsync();
    }

    private async Task ReturnBook(Guid id)
    {
        var loan = await Db.Loans.Include(l => l.Book).FirstOrDefaultAsync(l => l.Id == id);
        if (loan != null && loan.ReturnDate == null)
        {
            loan.ReturnDate = DateTime.UtcNow;
            if (loan.ReturnDate > loan.DueDate)
            {
                int daysLate = (int)(loan.ReturnDate.Value - loan.DueDate).TotalDays;
                loan.Fine = daysLate * 5;
            }
            if (loan.Book != null)
            {
                loan.Book.AvailableCopies++;
            }
            await Db.SaveChangesAsync();
            loans = await Db.Loans
                .Include(l => l.Book)
                .Include(l => l.Member)
                .OrderByDescending(l => l.IssueDate)
                .ToListAsync();
        }
    }
}
