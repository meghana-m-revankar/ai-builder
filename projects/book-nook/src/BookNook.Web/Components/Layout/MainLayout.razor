@using BookNook.Domain.Entities
@using BookNook.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject BookNookDbContext Db
@inject NavigationManager Nav

<div class="min-h-screen flex bg-canvas">
    <!-- Sidebar -->
    <aside class="w-64 bg-brand-900 text-white flex flex-col fixed inset-y-0 z-30 shadow-xl">
        <div class="p-6 flex items-center gap-3 border-b border-white/10">
            <div class="w-10 h-10 rounded-xl bg-accent-500 flex items-center justify-center text-white font-bold text-xl font-display shadow-lg">
                BN
            </div>
            <div>
                <h1 class="font-display font-bold text-lg tracking-tight">Book Nook</h1>
                <p class="text-xs text-white/60">Sunrise School Library</p>
            </div>
        </div>

        <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
            <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-white/80 hover:bg-white/10 hover:text-white" ActiveClass="bg-brand-700 text-white shadow-md">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                Dashboard
            </NavLink>
            <NavLink href="books" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-white/80 hover:bg-white/10 hover:text-white" ActiveClass="bg-brand-700 text-white shadow-md">
                <i data-lucide="book-open" class="w-5 h-5"></i>
                Books Catalogue
            </NavLink>
            <NavLink href="members" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-white/80 hover:bg-white/10 hover:text-white" ActiveClass="bg-brand-700 text-white shadow-md">
                <i data-lucide="users" class="w-5 h-5"></i>
                Members
            </NavLink>
            <NavLink href="loans" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-white/80 hover:bg-white/10 hover:text-white" ActiveClass="bg-brand-700 text-white shadow-md">
                <i data-lucide="book-check" class="w-5 h-5"></i>
                Circulation & Loans
            </NavLink>
            <NavLink href="overdue" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-white/80 hover:bg-white/10 hover:text-white" ActiveClass="bg-brand-700 text-white shadow-md">
                <i data-lucide="triangle-alert" class="w-5 h-5"></i>
                Overdue & Fines
            </NavLink>
        </nav>

        <div class="p-4 border-t border-white/10">
            <div class="flex items-center gap-3 px-3 py-3 rounded-xl bg-white/5">
                <div class="w-9 h-9 rounded-full bg-brand-500 text-white flex items-center justify-center font-bold text-sm">
                    MJ
                </div>
                <div class="overflow-hidden">
                    <p class="text-sm font-medium text-white truncate">Meena Joshi</p>
                    <p class="text-xs text-white/60 truncate">Head Librarian</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col pl-64">
        <!-- Top Bar -->
        <header class="h-20 bg-white border-b border-line px-8 flex items-center justify-between sticky top-0 z-20 shadow-xs">
            <div class="flex items-center gap-4 w-96">
                <div class="relative w-full">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-ink-600">
                        <i data-lucide="search" class="w-4 h-4"></i>
                    </span>
                    <input type="text" placeholder="Search books, members or ISBN..." class="w-full pl-10 pr-4 py-2 bg-canvas border border-line rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all" />
                </div>
            </div>

            <div class="flex items-center gap-4">
                <button class="relative p-2.5 rounded-xl border border-line bg-white hover:bg-canvas text-ink-600 transition-colors" aria-label="Notifications">
                    <i data-lucide="bell" class="w-5 h-5"></i>
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-accent-500"></span>
                </button>
                <div class="h-6 w-px bg-line"></div>
                <div class="flex items-center gap-3">
                    <div class="text-right">
                        <span class="block text-xs font-semibold uppercase tracking-wider text-ink-600">Branch</span>
                        <span class="text-sm font-bold text-brand-900">Sunrise School Pune</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page Body -->
        <main class="flex-1 p-8">
            @Body
        </main>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("window.initLucide");
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}
